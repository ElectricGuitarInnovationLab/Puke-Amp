diff --git a/IPlug/VST3/IPlugVST3_View.h b/IPlug/VST3/IPlugVST3_View.h
index 401c536a3..e9560121d 100644
--- a/IPlug/VST3/IPlugVST3_View.h
+++ b/IPlug/VST3/IPlugVST3_View.h
@@ -135,17 +135,27 @@ public:
 
   Steinberg::tresult PLUGIN_API setContentScaleFactor(ScaleFactor factor) override
   {
+#ifdef OS_MAC
+    // Cocoa owns backing density. Optional host UI zoom is not implemented;
+    // accepting it here would overwrite Retina density without resizing the UI.
+    return Steinberg::kResultFalse;
+#else
     mOwner.SetScreenScale(factor);
 
     return Steinberg::kResultOk;
+#endif
   }
 
   Steinberg::tresult PLUGIN_API queryInterface(const Steinberg::TUID _iid, void** obj) override
   {
+#ifndef OS_MAC
     QUERY_INTERFACE(_iid, obj, IPlugViewContentScaleSupport::iid, IPlugViewContentScaleSupport)
+#endif
     *obj = 0;
     return CPluginView::queryInterface(_iid, obj);
   }
